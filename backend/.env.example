# GozVision Backend ADK & MCP Server - Environment Configuration Example
# Copy to .env for local development

# Supabase Project URL & Service Role Key (bypasses RLS for system agents & SOS dispatches)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google Gemini API Key for clinical embeddings, RAG, and ambient scribe
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for ambient clinical SOAP scribe (optional, default: gemini-flash-latest)
GOZVISION_SCRIBE_MODEL=gemini-flash-latest

# Direct Postgres connection string with pooler (for migrations and SQL admin)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Server runtime port
PORT=8080
