# ─────────────────────────────────────────────────────────────────
# GozVision Environment Variables — Copy to .env and fill in values
# ─────────────────────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Google Gemini / ADK ─────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Google OAuth (Web Application Client) ──────────────────────
# Created in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Bachs Payments ──────────────────────────────────────────────
# Mode: 'sandbox' uses https://sandbox-api.bachs.io with sk_sandbox_... keys
#       'live'    uses https://api.bachs.io    with sk_live_...    keys
BACHS_MODE=sandbox
BACHS_API_KEY=sk_sandbox_your_key_here

# ─── Stripe Connect (optional, behind toggle in clinic UI) ────────
# Leave blank to disable Stripe Connect; only Bachs will be shown.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── App URLs ────────────────────────────────────────────────────
APP_BASE_URL=https://gozvision.vercel.app
CLINIC_BASE_URL=https://clinic.gozvision.vercel.app
