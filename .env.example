# ==============================================================================
# GOZVISION MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the project root:
#    cp .env.example .env
# 2. Fill in your specific API keys, Supabase credentials, and backend endpoints.
# 3. For client PWAs (Flutter), copy the required keys to:
#    - apps/clinic/assets/app.env
#    - apps/patient/assets/app.env
#    - backend/.env

# ------------------------------------------------------------------------------
# Google Gemini & Cloud AI
# ------------------------------------------------------------------------------
# API key for Gemini Multimodal Live, Agent reasoning, embeddings & clinical scribe
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud project ID (optional / GCP deployments)
GOOGLE_CLOUD_PROJECT=gozvision

# ------------------------------------------------------------------------------
# Supabase Ecosystem (Auth, Database, Storage & Realtime)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyz.supabase.co)
SUPABASE_URL=https://your_project_ref.supabase.co

# Supabase Public / Anon Key (Safe for client apps; protected by Postgres Row Level Security)
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Supabase Service Role Key (SERVER-SIDE ONLY: Bypasses RLS for SOS alerts, scribe drafts, recall sweeps)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Direct Postgres Connection URL (Session / transaction pooler for migrations & SQL scripts)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# GozVision Agent Development Kit (ADK) & MCP Backend
# ------------------------------------------------------------------------------
# Endpoint where Flutter clients connect to the ADK agent & MCP services
# Local: http://localhost:8080
# Production: https://your-backend.awsapprunner.com or https://your-backend.run.app
ADK_BACKEND_URL=http://localhost:8080

# Backend container port (Cloud Run / AWS App Runner / local)
PORT=8080

# LLM model used for ambient clinical SOAP note transcription
GOZVISION_SCRIBE_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# Pre-Seeded Clinical Ecosystem Demo Credentials
# ------------------------------------------------------------------------------
DEMO_PATIENT_EMAIL=demo-patient@gozvision.demo
DEMO_PATIENT_PASSWORD=gozvision-demo

DEMO_PRACTITIONER_EMAIL=practitioner@gozvision.demo
DEMO_PRACTITIONER_PASSWORD=gozvision-demo

DEMO_STAFF_EMAIL=staff@gozvision.demo
DEMO_STAFF_PASSWORD=gozvision-demo

DEMO_CAREGIVER_EMAIL=caregiver@gozvision.demo
DEMO_CAREGIVER_PASSWORD=gozvision-demo
