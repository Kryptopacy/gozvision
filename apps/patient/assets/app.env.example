# GozVision Patient Copilot PWA - Environment Configuration Example
# Copy to app.env for local development

# Google Gemini API Key for on-device live multimodal reasoning & assistance
GEMINI_API_KEY=your-gemini-api-key

# GozVision ADK / MCP Backend Service URL
ADK_BACKEND_URL=http://localhost:8080

# Supabase Project URL & Anon/Publishable Key (Row Level Security protected)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Pre-seeded Demo Patient Credentials (optional)
DEMO_PATIENT_EMAIL=demo-patient@gozvision.demo
DEMO_PATIENT_PASSWORD=gozvision-demo
